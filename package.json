{
  "name": "studio14-landing",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts tests/e2e/phase2-link.spec.ts",
    "test:e2e:phase2": "playwright test tests/e2e/phase2-link.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:motion": "playwright test tests/e2e/motion-performance.spec.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:headers": "node scripts/check-security-headers.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:links && npm run check:performance && npm run check:headers && npm run check:secrets"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.34.5"
}
